# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
DB_URL=jdbc:postgresql://<neon-host>/<dbname>?sslmode=require
DB_USERNAME=your_neon_user
DB_PASSWORD=your_neon_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=your_base64_encoded_jwt_secret_min_64_chars

# ─── AES-256 Encryption ───────────────────────────────────────────────────────
# Generate: openssl rand -base64 32   (must decode to exactly 32 bytes)
SMRITI_AES_KEY=your_base64_encoded_32byte_aes_key

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Gemini API ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

